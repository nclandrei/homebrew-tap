[
  {
    "formula": "claude-statusline",
    "repo": "nclandrei/claude-statusline",
    "branch": "main",
    "desc": "Minimal statusline renderer for Claude Code",
    "license": "MIT",
    "build": {
      "type": "cargo"
    },
    "test": [
      "input = '{\"model\":{\"display_name\":\"Opus\"},' \\",
      "        '\"workspace\":{\"current_dir\":\"/tmp/test\"},' \\",
      "        '\"context_window\":{\"used_percentage\":42.7}}'",
      "output = pipe_output(\"#{bin}/claude-statusline\", input)",
      "assert_match \"Opus\", output",
      "assert_match \"test\", output",
      "assert_match \"42%\", output"
    ]
  },
  {
    "formula": "distill",
    "repo": "nclandrei/distill",
    "branch": "main",
    "desc": "Monitor AI agent sessions and propose reusable skills",
    "license": "MIT",
    "build": {
      "type": "cargo"
    },
    "test": [
      "assert_match \"distill\", shell_output(\"#{bin}/distill --help\")"
    ]
  },
